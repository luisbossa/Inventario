<%
  const alertasInsumos = resumen.total_alertas;
  const alertasRepuestos = repResumen.por_reponer;
  const accesos = [
    {
      href: "/consumibles",
      color: "azul",
      icono: "fa-print",
      titulo: "Tóner y tintas",
      texto: `${resumen.total_modelos} modelos · ${resumen.total_unidades} unidades`,
      alerta: alertasInsumos ? `${alertasInsumos} por reponer` : null,
    },
    {
      href: "/repuestos",
      color: "verde",
      icono: "fa-keyboard",
      titulo: "Repuestos y periféricos",
      texto: `${repResumen.total_articulos} artículos · ${repResumen.total_unidades} unidades`,
      alerta: alertasRepuestos ? `${alertasRepuestos} por reponer` : null,
    },
    {
      href: "/consumibles/movimientos",
      color: "naranja",
      icono: "fa-clipboard-list",
      titulo: "Registro de movimientos",
      texto: `${resumen.entregas_mes} insumos entregados este mes`,
    },
    {
      href: "/repuestos/entregas",
      color: "morado",
      icono: "fa-people-arrows",
      titulo: "Entregas a funcionarios",
      texto: `${repResumen.entregas_mes} repuestos entregados este mes`,
    },
    {
      href: "/repuestos/prestamos",
      color: "rosa",
      icono: "fa-clock-rotate-left",
      titulo: "Préstamos",
      texto: repResumen.prestamos_activos
        ? `${repResumen.prestamos_activos} pendiente(s) de devolución`
        : "Sin préstamos pendientes",
    },
    {
      href: "/consumibles/exportar.csv",
      color: "turquesa",
      icono: "fa-chart-column",
      titulo: "Reportes",
      texto: "Descargar inventario y entregas en Excel",
    },
  ];
%>

<section class="bienvenida">
  <h1 class="bienvenida__titulo">¿Qué querés hacer hoy?</h1>
  <p class="bienvenida__sub">Elegí un apartado para entrar</p>
</section>

<nav class="accesos" aria-label="Apartados">
  <% accesos.forEach((a) => { %>
    <a class="acceso acceso--<%= a.color %>" href="<%= a.href %>">
      <span class="acceso__icono" aria-hidden="true"><i class="fa-solid <%= a.icono %>"></i></span>
      <span class="acceso__titulo"><%= a.titulo %></span>
      <span class="acceso__texto"><%= a.texto %></span>
      <% if (a.alerta) { %>
        <span class="acceso__alerta"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <%= a.alerta %></span>
      <% } %>
    </a>
  <% }) %>
</nav>

<div class="graficos-fila graficos-fila--principal">
  <section class="panel panel--color panel--azul" aria-labelledby="mes-titulo">
    <div class="panel__cabecera">
      <div>
        <h2 id="mes-titulo" class="panel__titulo">
          <i class="fa-solid fa-chart-column" aria-hidden="true"></i> Entregas por mes
        </h2>
        <p class="panel__desc">Unidades entregadas en los últimos 6 meses</p>
      </div>
    </div>
    <div class="panel__cuerpo">
      <%- include("partials/grafico-meses", { meses: porMes }) %>
    </div>
  </section>

  <section class="panel panel--color panel--verde" aria-labelledby="estado-titulo">
    <div class="panel__cabecera">
      <div>
        <h2 id="estado-titulo" class="panel__titulo">
          <i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Estado del inventario
        </h2>
        <p class="panel__desc">Artículos según su existencia</p>
      </div>
    </div>
    <div class="panel__cuerpo">
      <%- include("partials/grafico-estado", { filas: estados }) %>
    </div>
  </section>
</div>

<div class="graficos-fila">
  <section class="panel panel--color panel--azul" aria-labelledby="lugar-titulo">
    <div class="panel__cabecera">
      <h2 id="lugar-titulo" class="panel__titulo">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i> Consumo por lugar
      </h2>
    </div>
    <div class="panel__cuerpo">
      <%- include("partials/barras", { filas: porLugar, color: "azul", vacio: "Sin entregas registradas." }) %>
    </div>
  </section>

  <section class="panel panel--color panel--morado" aria-labelledby="tecnico-titulo">
    <div class="panel__cabecera">
      <h2 id="tecnico-titulo" class="panel__titulo">
        <i class="fa-solid fa-user-gear" aria-hidden="true"></i> Entregas por técnico
      </h2>
    </div>
    <div class="panel__cuerpo">
      <%- include("partials/barras", { filas: porTecnico, color: "morado", vacio: "Sin entregas registradas." }) %>
    </div>
  </section>

  <section class="panel panel--color panel--turquesa" aria-labelledby="marca-titulo">
    <div class="panel__cabecera">
      <h2 id="marca-titulo" class="panel__titulo">
        <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Existencias por marca
      </h2>
    </div>
    <div class="panel__cuerpo">
      <%- include("partials/barras", { filas: porMarca, color: "turquesa", vacio: "Sin insumos en existencia." }) %>
    </div>
  </section>
</div>

<section class="panel panel--color panel--rojo" aria-labelledby="reponer-titulo">
  <div class="panel__cabecera">
    <h2 id="reponer-titulo" class="panel__titulo">
      <i class="fa-solid fa-box-open" aria-hidden="true"></i> Necesitan reposición
      <span class="contador"><%= porReponer.length %></span>
    </h2>
    <% if (porReponer.length > 0) { %>
      <div class="encabezado__acciones">
        <a class="enlace" href="/consumibles?estado=bajo">Ver insumos</a>
        <a class="enlace" href="/repuestos?estado=agotado">Ver repuestos</a>
      </div>
    <% } %>
  </div>
  <% if (porReponer.length === 0) { %>
    <p class="panel__cuerpo ayuda">Todo está sobre su stock mínimo. 🎉</p>
  <% } else { %>
    <ul class="lista-reponer">
      <% porReponer.slice(0, 10).forEach((r) => { %>
        <li>
          <a href="<%= r.href %>">
            <span class="lista-reponer__nombre"><%= r.nombre %></span>
            <span class="lista-reponer__detalle"><%= r.detalle %></span>
          </a>
          <span class="estado estado--<%= r.estado %>"><%= r.stock %> · <%= ETIQUETA_ESTADO[r.estado] %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= titulo %> · Inventario CGI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/app.css" />
    <%- style %>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
  </head>

  <body>
    <div class="app">
      <input id="menu-toggle" class="visually-hidden" type="checkbox" />
      <%- include("../partials/sidebar") %>
      <label class="fondo-menu" for="menu-toggle" aria-hidden="true"></label>
      <%- include("../partials/topbar") %>

      <main class="contenido" id="contenido">
        <%- include("../partials/flash") %>
        <%- body %>
        <footer class="pie">
          © <%= new Date().getFullYear() %> Departamento de Informática · Área de Salud Naranjo
        </footer>
      </main>
    </div>

    <script src="/js/app.js"></script>
    <%- script %>
  </body>
</html>
